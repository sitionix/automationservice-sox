<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.sitionix.atmssox</groupId>
    <artifactId>automationservice</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <packaging>pom</packaging>
    <name>automationservice-sox</name>
    <description>Automation service</description>

    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <modules>
        <module>boot</module>
        <module>api-rest</module>
        <module>application</module>
        <module>domain</module>
        <module>infrastructure</module>
        <module>jacoco-report</module>
    </modules>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.34</lombok.version>
        <mockito.version>5.12.0</mockito.version>
        <junit.version>4.13.2</junit.version>
        <mapstruct.version>1.6.2</mapstruct.version>
        <jacoco.version>0.8.10</jacoco.version>
        <validation.version>2.0.1.Final</validation.version>
        <spring.version>3.3.4</spring.version>
        <testcontainers.version>1.20.1</testcontainers.version>
        <forgeit.version>0.0.38</forgeit.version>
        <forge.security.version>0.0.7</forge.security.version>
        <sonar.coverage.exclusions>
            application/src/main/java/com/sitionix/atmssox/application/usecase/ActiveUserAgentResolver.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ChatCompletedContext.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ChatExecutionAsyncProcessor.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ContextOptimizationContext.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ContextOptimizationCoverageCalculator.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ContextOptimizerAgentExecutionHandler.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ContextOptimizerAsyncService.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ContextOptimizerPolicy.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ContextOptimizerPostChatWorkflow.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ContextOptimizerProperties.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/ContextOptimizerTrigger.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/OpenAiJsonResponseParser.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/PostChatWorkflow.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/PostChatWorkflowDispatcher.java,
            application/src/main/java/com/sitionix/atmssox/application/usecase/RuleSuggestionPostChatWorkflow.java,
            boot/src/main/java/com/sitionix/atmssox/config/AsyncConfiguration.java,
            boot/src/main/java/com/sitionix/atmssox/config/AsyncExecutorsProperties.java,
            infrastructure/postgresql/src/main/java/com/sitionix/atmssox/postgresql/mapper/AgentRuleAuthorTypeInfraMapper.java,
            infrastructure/postgresql/src/main/java/com/sitionix/atmssox/postgresql/mapper/AgentRuleStatusInfraMapper.java,
            infrastructure/postgresql/src/main/java/com/sitionix/atmssox/postgresql/repository/AgentRepositoryImpl.java,
            infrastructure/postgresql/src/main/java/com/sitionix/atmssox/postgresql/repository/AgentRuleRepositoryImpl.java,
            infrastructure/postgresql/src/main/java/com/sitionix/atmssox/postgresql/repository/ConversationContextSnapshotRepositoryImpl.java,
            infrastructure/postgresql/src/main/java/com/sitionix/atmssox/postgresql/repository/ConversationMessageRepositoryImpl.java
        </sonar.coverage.exclusions>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- MODULE -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>api-rest</artifactId>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>application</artifactId>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>boot</artifactId>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>domain</artifactId>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>postgresql</artifactId>
            </dependency>
            <!-- DEPENDENCY -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.0.0-M7</version>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>

                    <executions>
                        <!-- MAIN: MapStruct + Lombok + binding -->
                        <execution>
                            <id>default-compile</id>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                            <configuration>
                                <annotationProcessorPaths>
                                    <path>
                                        <groupId>org.mapstruct</groupId>
                                        <artifactId>mapstruct-processor</artifactId>
                                        <version>${mapstruct.version}</version>
                                    </path>
                                    <path>
                                        <groupId>org.projectlombok</groupId>
                                        <artifactId>lombok</artifactId>
                                        <version>${lombok.version}</version>
                                    </path>
                                    <path>
                                        <groupId>org.projectlombok</groupId>
                                        <artifactId>lombok-mapstruct-binding</artifactId>
                                        <version>0.2.0</version>
                                    </path>
                                </annotationProcessorPaths>
                            </configuration>
                        </execution>

                        <!-- TEST: Forge-IT + Lombok -->
                        <execution>
                            <id>default-testCompile</id>
                            <goals>
                                <goal>testCompile</goal>
                            </goals>
                            <configuration>
                                <annotationProcessorPaths>
                                    <path>
                                        <groupId>com.sitionix.forgeit</groupId>
                                        <artifactId>forge-it-annotation-processor</artifactId>
                                        <version>${forgeit.version}</version>
                                    </path>
                                    <path>
                                        <groupId>org.projectlombok</groupId>
                                        <artifactId>lombok</artifactId>
                                        <version>${lombok.version}</version>
                                    </path>
                                </annotationProcessorPaths>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <mainClass>com.sitionix.atmssox.Application</mainClass>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>github-forge-it</id>
            <url>https://maven.pkg.github.com/sitionix/forge-it</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>github-app-afesox</id>
            <url>https://maven.pkg.github.com/sitionix/app-afesox</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>github-forge-security</id>
            <url>https://maven.pkg.github.com/sitionix/forge-security</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
